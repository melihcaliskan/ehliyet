PORT=3000
# Turso: libsql://<db>-<org>.turso.io  (turso db show <db> --url)
# Yerel geliştirme: file:./data/ehliyet.db
DATABASE_URL=file:./data/ehliyet.db
DATABASE_AUTH_TOKEN=            # turso db tokens create <db>
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=60
APPLE_BUNDLE_ID=com.melihcaliskan.ehliyet
# Xcode (StoreKit config ile yerel test) | Sandbox | Production
APPLE_ENVIRONMENT=Xcode
APPLE_APP_APPLE_ID=             # Production için zorunlu
APPLE_ROOT_CERTS_DIR=./certs    # AppleRootCA-G3.cer (Sandbox/Production)

# Video depolama — Cloudflare R2 (10 GB ücretsiz, egress ücretsiz)
# Cloudflare panel › R2 › Create bucket; Manage API tokens › Object Read & Write
STORAGE_ENDPOINT=               # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=ehliyet-videos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
VIDEO_URL_TTL_SEC=14400         # imzalı link süresi (4 saat)

# Yönetim paneli (http://localhost:3000/admin) erişimi
ADMIN_EMAILS=mlhclskn@gmail.com
